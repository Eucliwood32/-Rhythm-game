--- !u!114 &973000701
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 973000687}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d4ff353ff2e2eb942a57196cae707ac7, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::GameFlow
  music: {fileID: 0}
  composer: {fileID: 0}
  judge: {fileID: 0}
  referee: {fileID: 0}
  noteDisplay: {fileID: 0}
  hud: {fileID: 0}
  boss: {fileID: 0}
  debugOverlay: {fileID: 0}
  gameTitle: "\uB9D0\uB3C4 \uC548\uB3FC! \uB0B4\uAC00 \uB108\uAC19\uC740 \uC57D\uACE8\uC774\uB791
    \uC0AC\uADC0\uB77C\uACE0?\n\uBB34\uB9AC\uBB34\uB9AC!!!"
  subtitle: "~\uB9C8\uCF00\uC774\uB204\uAC00 \uB41C \uB098, \uB2E4\uC2DC \uD55C\uBC88
    \uADF8\uB140\uC5D0\uAC8C \uC0AC\uB791\uC744 \uB3C4\uC804\uD558\uB2E4~"
  titleBackground: {fileID: 0}
  skipTitleAndStory: 0
  stages:
  - title: STAGE 1
    clip: {fileID: 0}
    chart: {fileID: 0}
    background: {fileID: 0}
    isBoss: 0
    bossName: 
    bossSprite: {fileID: 0}
    cutInImage: {fileID: 0}
    storyBefore:
    - speaker: 
      text: "20XX\uB144. \uD604\uB300 \uBB34\uAE30\uAC00 \uAE30\uC601\uC774 \uBC15\uC0AC\uAC00
        \uBC1C\uACAC\uD55C '\uAE30' \uC55E\uC5D0\uC11C \uBB34\uB825\uD574\uC9C4 \uC9C0
        \uC5B4\uC5B8 40\uB144\u2026"
    - speaker: 
      text: "\uAC01 \uB098\uB77C\uB294 \uC5B4\uB9B4 \uB54C\uBD80\uD130 \uD559\uC0DD\uB4E4\uC744
        \uC778\uAC04\uD749\uAE30\uB85C \uD0A4\uC6B0\uAE30 \uC704\uD574, \uAE30\uC874
        \uAD50\uC721\uACFC\uC815\uC744 \uACA9\uD22C \uAD50\uC721\uACFC\uC815\uC73C\uB85C
        \uBC14\uAFBC \uC9C0 \uC624\uB798\uB2E4."
    - speaker: 
      text: "\uADF8\uB7F0 \uC704\uB300\uD55C \uAE30\uC601\uC774 \uBC15\uC0AC\uC758
        \uC190\uB140\uB538, '\uD788\uCE74\uB9AC'\uAC00 \uC6B0\uB9AC \uD559\uAD50\uC5D0
        \uC785\uD559\uD588\uB2E4!!"
    - speaker: 
      text: "\uB098\uB294 \uC5B4\uB9B4 \uC801, \uADF8\uB140\uC5D0\uAC8C \uCC28\uC778
        \uC804\uC801\uC774 \uC788\uB2E4."
    - speaker: "\uC5B4\uB9B0 \uD788\uCE74\uB9AC"
      text: "\uB098\uBCF4\uB2E4 \uC57D\uD55C \uB140\uC11D\uC758 \uB9D0 \uB530\uC704
        \uB4E3\uC9C0 \uC54A\uB294\uB2E4. \uAEBC\uC838\uB77C."
    - speaker: 
      text: "\uADF8\uB54C\uBD80\uD130 \uB098\uB294 \uC808\uCE58\uBD80\uC2EC\uD558\uC5EC,
        \uADF8\uB140\uBCF4\uB2E4 \uAC15\uD574\uC9C0\uAE30 \uC704\uD574 \uC628\uAC16
        \uBC29\uBC95\uC744 \uB2E4 \uC37C\uB2E4."
    - speaker: 
      text: "\uADF8\uB9AC\uACE0 \uB9C8\uCE68\uB0B4, 12\uB144 \uB9CC\uC5D0 \uB098\uB294
        \uADF8\uB140 \uC55E\uC5D0 \uB2E4\uC2DC \uC130\uB2E4."
    - speaker: "\uAC15\uB450\uCCA0"
      text: "\uD788\uCE74\uB9AC! \uB108\uC5D0\uAC8C \uD560 \uB9D0\uC774 \uC788\uB2E4!"
    - speaker: "\uD788\uCE74\uB9AC"
      text: "\uC5C9?"
    - speaker: 
      text: "\uC6B0\uB77D\uBD80\uB77D\uD55C \uB300\uD1F4\uC0AC\uB450\uADFC, \uB2F9\uC7A5\uC774\uB77C\uB3C4
        \uD130\uC9C8 \uB4EF\uD55C \uB300\uD749\uADFC, \uADF8\uB9AC\uACE0 \uCA4D \uBC8C\uC5B4\uC9C4
        \uAD11\uBC30\uADFC\u2026"
    - speaker: 
      text: "\uD2C0\uB9BC\uC5C6\uB2E4. \uADF8\uB140\uB294 \uB098\uC758 \uBBA4\uC988\uB2E4."
    - speaker: "\uAC15\uB450\uCCA0"
      text: "\uB110 \uC88B\uC544\uD55C\uB2E4!"
    - speaker: "\uD788\uCE74\uB9AC"
      text: "\uD760. \uB098\uBCF4\uB2E4 \uAC15\uD574\uC57C \uD55C\uB2E4."
    - speaker: "\uAC15\uB450\uCCA0"
      text: "\uADF8\uB798! \uC54C\uACA0\uB2E4!"
    - speaker: "\uD788\uCE74\uB9AC"
      text: "\uADF8\uB9AC\uACE0 \uB108 \uB9D0\uACE0\uB3C4 \uC5EC\uAE30 \uC804\uAD50\uC0DD\uC774
        \uB611\uAC19\uC740 \uB9D0\uC744 \uD588\uC9C0."
    - speaker: "\uAC15\uB450\uCCA0"
      text: "\uBB50\uB77C\uACE0?!"
    - speaker: 
      text: "\uC5B4\uB290 \uC21C\uAC04, \uC804\uAD50\uC0DD\uC774 \uC8FC\uBCC0\uC5D0
        \uBC14\uAE00\uBC14\uAE00\uD588\uB2E4."
    - speaker: "\uD788\uCE74\uB9AC"
      text: "\uC5EC\uAE30\uC11C \uC624\uC9C1 \uB2E8 \uD55C \uBA85\uB9CC\uC774, \uB0B4
        \uC0C1\uB300\uAC00 \uB420 \uC218 \uC788\uB2E4!"
    - speaker: 
      text: "\uBC30\uD2C0\uB85C\uC584\uC774 \uC2DC\uC791\uB410\uB2E4! \uBAA8\uB450\uB97C
        \uC4F0\uB7EC\uB728\uB824\uB77C!\nA\uD0A4: \uC288\uD37C \uB4DC\uB798\uACE4
        \uB77C\uC774\uC9D5 \uC5B4\uD37C\uCEF7 (\uC704\uCABD \uB178\uD2B8)   B\uD0A4:
        \uD5E5\uD1A0\uD30C\uC2A4\uCE7C \uB4DC\uB9B4 \uCD08\uC804\uB3C4\uCCB4 \uD0A5
        (\uC544\uB798\uCABD \uB178\uD2B8)"
  - title: BOSS
    clip: {fileID: 0}
    chart: {fileID: 0}
    background: {fileID: 0}
    isBoss: 1
    bossName: "\uD788\uCE74\uB9AC"
    bossSprite: {fileID: 0}
    cutInImage: {fileID: 0}
    storyBefore:
    - speaker: "\uD788\uCE74\uB9AC"
      text: "\uC804\uBD80 \uC4F0\uB7EC\uB728\uB838\uAD70."
    - speaker: 
      text: "\uC0B0\uCC98\uB7FC \uC313\uC778 \uC804\uAD50\uC0DD\uC758 \uC5B8\uB355
        \uC704\uB85C, \uADF8\uB140\uAC00 \uBAA8\uC2B5\uC744 \uB4DC\uB7EC\uB0C8\uB2E4."
    - speaker: "\uAC15\uB450\uCCA0"
      text: "\uD788\uCE74\uB9AC! \uC774\uC81C \uC57D\uC18D\uB300\uB85C \uB0B4 \uC5F0\uC778\uC774
        \uB418\uC5B4\uC11C, \uD3C9\uC0DD \uB098\uC5D0\uAC8C \uB41C\uC7A5\uCC0C\uAC1C\uC640
        \uACC4\uB780\uD6C4\uB77C\uC774\uB97C \uB9CC\uB4E4\uC5B4 \uC918\uB77C!"
    - speaker: "\uD788\uCE74\uB9AC"
      text: "\uB0B4\uAC00 \uC5B8\uC81C \uC5F0\uC778\uC774\uB77C \uD588\uC9C0?"
    - speaker: "\uD788\uCE74\uB9AC"
      text: "\uB098\uBCF4\uB2E4 \uC57D\uD55C \uC790\uC758 \uB9D0\uC740 \uB4E3\uC9C0
        \uC54A\uB294\uB2E4. \uB108\uB294 \uB098\uBCF4\uB2E4 \uC57D\uD55C\uAC00, \uAC15\uD55C\uAC00?"
    - speaker: "\uAC15\uB450\uCCA0"
      text: "\uBB63!! \uADF8\uB798 \uC88B\uB2E4! \uB098 \uC0AC\uB098\uC774 \uAC15\uB450\uCCA0,
        \uC774\uBC88\uC5D0\uC57C\uB9D0\uB85C\u2026 12\uB144 \uB9CC\uC5D0 \uB2E4\uC2DC\uAE08
        \uB108\uC758 \uB9C8\uC74C\uC744 \uBE8F\uC5B4 \uAC00 \uC8FC\uC9C0!"
  ending: []
  portraits: []
  bossIntroTime: 2.5
  stageClearTime: 2.5
  gameOverTime: 2
